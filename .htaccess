RewriteEngine On
RewriteBase /STI_Queueing-System/

# Web Routes
RewriteRule ^kiosk/?$ monitor [R=302,L]
RewriteRule ^monitor/?$ pages/monitor.php [L]
RewriteRule ^staff-login/?$ pages/staff-login.php [L]
RewriteRule ^admin-dashboard/?$ pages/admin-dashboard.php [L]
RewriteRule ^staff-dashboard/?$ pages/staff-dashboard.php [L]
RewriteRule ^doctor-dashboard/?$ pages/doctor-dashboard.php [L]
RewriteRule ^attendance/?$ pages/attendance.php [L]
RewriteRule ^staff-management/?$ pages/admin-dashboard.php [L]

# API Routes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/(.+)$ api/$1.php [L]
